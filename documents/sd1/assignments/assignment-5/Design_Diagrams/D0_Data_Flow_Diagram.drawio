<mxfile host="drawio"><diagram name="D0 Data-Flow Diagram"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1700" pageHeight="1100"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;font style='font-size:20px'&gt;&lt;b&gt;Pulse&lt;/b&gt; - platform-independent IoT communication for resilient farm sensor networks&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:15px'&gt;D0 High-Level Design - Data-Flow Diagram (Team: Jacob Cohen, Sujal Choukse, Yatharth Bajaj)&lt;/font&gt;&lt;br&gt;&lt;b&gt;Goal:&lt;/b&gt; move every farm sensor reading from a field device to a trusted Hub over any available link, and keep each reading until the Hub stores it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="90" as="geometry"/></mxCell><mxCell id="v2" value="&lt;b&gt;Flow A - Telemetry&lt;/b&gt; (one reading, field to Hub, then the receipt back)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="900" height="25" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;Field sensor&lt;/b&gt;&lt;br&gt;(external)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;dashed=1;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="120" height="70" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;A1 Sample&lt;/b&gt;&lt;br&gt;C1 Sensor Driver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e89;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="300" y="170" width="150" height="70" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;A2 Package&lt;/b&gt;&lt;br&gt;C2 Edge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e89;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="590" y="170" width="150" height="70" as="geometry"/></mxCell><mxCell id="v6" value="&lt;b&gt;A3 Queue and sign&lt;/b&gt;&lt;br&gt;C3 Node (field)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e89;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="880" y="170" width="170" height="70" as="geometry"/></mxCell><mxCell id="v7" value="&lt;b&gt;Radio / IP link&lt;/b&gt;&lt;br&gt;(external)" style="ellipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1150" y="155" width="150" height="100" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b&gt;A4 Verify sender&lt;/b&gt;&lt;br&gt;C3 Node (hub)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e89;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1420" y="170" width="190" height="70" as="geometry"/></mxCell><mxCell id="v9" value="&lt;b&gt;A5 Decode, check, store&lt;/b&gt;&lt;br&gt;C5 Hub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e89;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1420" y="450" width="190" height="70" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b&gt;SQLite&lt;/b&gt; &lt;i&gt;readings&lt;/i&gt;&lt;br&gt;(external)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#eeeeee;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1110" y="435" width="170" height="100" as="geometry"/></mxCell><mxCell id="e11" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v3" target="v4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v12" value="&lt;b&gt;I1&lt;/b&gt; physical quantity&lt;br&gt;&lt;i&gt;analog or bus signal&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="150" width="140" height="50" as="geometry"/></mxCell><mxCell id="e13" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v4" target="v5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v14" value="&lt;b&gt;I2&lt;/b&gt; raw reading&lt;br&gt;&lt;i&gt;payload bytes + encoding&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="150" width="140" height="50" as="geometry"/></mxCell><mxCell id="e15" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v5" target="v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v16" value="&lt;b&gt;I3&lt;/b&gt; PulseEnvelope in PublishRequest&lt;br&gt;&lt;i&gt;Protobuf frame&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="135" width="140" height="65" as="geometry"/></mxCell><mxCell id="e17" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v6" target="v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v18" value="&lt;b&gt;I4, I5&lt;/b&gt; signed packet&lt;br&gt;&lt;i&gt;TransportPacket&lt;/i&gt;&lt;br&gt;via C4" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="95" width="120" height="65" as="geometry"/></mxCell><mxCell id="e19" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v7" target="v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v20" value="&lt;b&gt;I5, I4&lt;/b&gt; signed packet&lt;br&gt;&lt;i&gt;TransportPacket&lt;/i&gt;&lt;br&gt;via C4" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1295" y="95" width="130" height="65" as="geometry"/></mxCell><mxCell id="e21" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v8" target="v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v22" value="&lt;b&gt;I6&lt;/b&gt; verified envelope&lt;br&gt;&lt;i&gt;DeliveryEvent&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=bottom;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="330" width="170" height="50" as="geometry"/></mxCell><mxCell id="e23" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v9" target="v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v24" value="&lt;b&gt;I7&lt;/b&gt; validated record&lt;br&gt;&amp;#8594; &lt;i&gt;stored row,&lt;br&gt;one per sample&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1280" y="400" width="140" height="60" as="geometry"/></mxCell><mxCell id="e25" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;dashed=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#b03a2e;fontColor=#b03a2e;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v9" target="v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v26" value="&lt;b&gt;I6&lt;/b&gt; receipt request&lt;br&gt;&lt;i&gt;AckRequest STORED&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=12;fontColor=#b03a2e;" vertex="1" parent="1"><mxGeometry x="1580" y="330" width="90" height="65" as="geometry"/></mxCell><mxCell id="e27" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;dashed=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#b03a2e;fontColor=#b03a2e;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=0.93;entryY=0.72;entryDx=0;entryDy=0;" edge="1" parent="1" source="v8" target="v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e28" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;dashed=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#b03a2e;fontColor=#b03a2e;exitX=0.07;exitY=0.72;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="v7" target="v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v29" value="&lt;b&gt;I5&lt;/b&gt; signed receipt&lt;br&gt;&lt;i&gt;StatusUpdate STORED&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=12;fontColor=#b03a2e;" vertex="1" parent="1"><mxGeometry x="1140" y="262" width="170" height="45" as="geometry"/></mxCell><mxCell id="e30" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;dashed=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#b03a2e;fontColor=#b03a2e;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v6" target="v5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="931" y="340"/><mxPoint x="665" y="340"/></Array></mxGeometry></mxCell><mxCell id="v31" value="&lt;b&gt;I3&lt;/b&gt; delivery status &lt;i&gt;StatusEvent STORED&lt;/i&gt;; field copy removed" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=12;fontColor=#b03a2e;" vertex="1" parent="1"><mxGeometry x="640" y="342" width="320" height="40" as="geometry"/></mxCell><mxCell id="v32" value="&lt;b&gt;Timing budget&lt;/b&gt;&lt;br&gt;&amp;#8226; A1: one sample every 60 s.&lt;br&gt;&amp;#8226; A3 to A5: a reading must be stored within 3,600 s, or it expires (US-01).&lt;br&gt;&amp;#8226; A3: resend every 30 s, up to 5 times.&lt;br&gt;&amp;#8226; A2 and A5: reconnect to the local Node after 100 ms, doubling up to 5 s." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#b58900;align=left;verticalAlign=top;spacingLeft=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="700" height="100" as="geometry"/></mxCell><mxCell id="v33" value="&lt;b&gt;Flow B - Configuration&lt;/b&gt; (build time, before a device starts)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="900" height="25" as="geometry"/></mxCell><mxCell id="v34" value="Deployment&lt;br&gt;engineer" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="660" width="40" height="70" as="geometry"/></mxCell><mxCell id="v35" value="&lt;b&gt;B1 Validate&lt;/b&gt;&lt;br&gt;C6 Builder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e89;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="300" y="660" width="170" height="70" as="geometry"/></mxCell><mxCell id="v36" value="&lt;b&gt;B2 Split&lt;/b&gt;&lt;br&gt;C6 Builder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e89;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="650" y="660" width="170" height="70" as="geometry"/></mxCell><mxCell id="v37" value="&lt;b&gt;B3 Start&lt;/b&gt;&lt;br&gt;C3 Node, C2 Edge, C5 Hub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e89;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="660" width="210" height="70" as="geometry"/></mxCell><mxCell id="e38" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v34" target="v35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v39" value="&lt;b&gt;I8&lt;/b&gt; device TOML + platform&lt;br&gt;&lt;i&gt;schema version 1 text&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=12;" vertex="1" parent="1"><mxGeometry x="105" y="640" width="190" height="50" as="geometry"/></mxCell><mxCell id="e40" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v35" target="v36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v41" value="validated configuration&lt;br&gt;&lt;i&gt;parsed sections&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="640" width="180" height="50" as="geometry"/></mxCell><mxCell id="e42" value="" style="endArrow=open;html=1;strokeWidth=2;dashed=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#6c3483;fontColor=#6c3483;" edge="1" parent="1" source="v36" target="v37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v43" value="&lt;b&gt;I9&lt;/b&gt; per-component files&lt;br&gt;&lt;i&gt;node.toml, edge.toml,&lt;br&gt;hub.flags&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=12;fontColor=#6c3483;" vertex="1" parent="1"><mxGeometry x="820" y="625" width="180" height="65" as="geometry"/></mxCell><mxCell id="v44" value="&lt;b&gt;I8&lt;/b&gt; error list + nonzero exit status" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=12;fontColor=#b03a2e;" vertex="1" parent="1"><mxGeometry x="60" y="806" width="300" height="25" as="geometry"/></mxCell><mxCell id="e45" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;dashed=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#b03a2e;fontColor=#b03a2e;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v35" target="v34"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="385" y="800"/><mxPoint x="25" y="800"/><mxPoint x="25" y="695"/></Array></mxGeometry></mxCell><mxCell id="v46" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;verticalAlign=top;align=left;spacingLeft=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1250" y="560" width="390" height="300" as="geometry"/></mxCell><mxCell id="v47" value="A#" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e89;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1265" y="590" width="60" height="30" as="geometry"/></mxCell><mxCell id="v48" value="Process stage. The text names the component (C#) that does it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1335" y="585" width="300" height="40" as="geometry"/></mxCell><mxCell id="v49" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;dashed=1;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1265" y="635" width="60" height="30" as="geometry"/></mxCell><mxCell id="v50" value="External source or sink (grey dashed box, cylinder, or oval)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1335" y="632" width="300" height="40" as="geometry"/></mxCell><mxCell id="v51" value="&lt;b&gt;&amp;#8212;&amp;#9654;&lt;/b&gt; Data that moves forward. Label = data name, then its &lt;i&gt;form&lt;/i&gt; at that point." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1265" y="675" width="370" height="40" as="geometry"/></mxCell><mxCell id="v52" value="&lt;font color='#b03a2e'&gt;&lt;b&gt;- - &amp;#9654;&lt;/b&gt; Receipt or error that moves back to the sender.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1265" y="720" width="370" height="36" as="geometry"/></mxCell><mxCell id="v53" value="&lt;font color='#6c3483'&gt;&lt;b&gt;- - &amp;gt;&lt;/b&gt; Configuration file copied to a host.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1265" y="760" width="370" height="30" as="geometry"/></mxCell><mxCell id="v54" value="Yellow note = timing budget. &lt;b&gt;I#&lt;/b&gt; = interface in the block diagram." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1265" y="792" width="370" height="40" as="geometry"/></mxCell><mxCell id="v55" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1285" y="832" width="18" height="22" as="geometry"/></mxCell><mxCell id="v56" value="Person who uses the system." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1335" y="830" width="300" height="25" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>