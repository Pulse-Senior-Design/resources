<mxfile host="drawio"><diagram name="D0 Block Diagram"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1700" pageHeight="1100"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;font style='font-size:20px'&gt;&lt;b&gt;Pulse&lt;/b&gt; - platform-independent IoT communication for resilient farm sensor networks&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:15px'&gt;D0 High-Level Design - Block Diagram (Team: Jacob Cohen, Sujal Choukse, Yatharth Bajaj)&lt;/font&gt;&lt;br&gt;&lt;b&gt;Goal:&lt;/b&gt; move every farm sensor reading from a field device to a trusted Hub over any available link, and keep each reading until the Hub stores it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="90" as="geometry"/></mxCell><mxCell id="v2" value="&lt;b&gt;Field device&lt;/b&gt; (external platform)&lt;br&gt;target: Heltec ESP32-S3 LoRa board; now: Linux desktop bench" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="620" height="520" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;Hub host&lt;/b&gt; (external platform)&lt;br&gt;Linux computer or Raspberry Pi" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1000" y="130" width="640" height="520" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;Field sensor&lt;/b&gt;&lt;br&gt;(external hardware)&lt;br&gt;soil, water, environment" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;dashed=1;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="80" y="210" width="220" height="70" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;C1 Sensor Driver&lt;/b&gt;&lt;br&gt;reads one sensor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e89;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="360" width="220" height="70" as="geometry"/></mxCell><mxCell id="v6" value="&lt;b&gt;C2 Edge&lt;/b&gt;&lt;br&gt;packages samples on a schedule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e89;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="530" width="220" height="70" as="geometry"/></mxCell><mxCell id="v7" value="&lt;b&gt;C3 Node&lt;/b&gt; (field instance)&lt;br&gt;queues, signs, verifies messages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e89;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="390" y="530" width="250" height="70" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b&gt;C4 Transport Adapter&lt;/b&gt; (field instance)&lt;br&gt;moves signed packets on one carrier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e89;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="390" y="360" width="250" height="70" as="geometry"/></mxCell><mxCell id="v9" value="&lt;b&gt;Radio / IP link&lt;/b&gt; (external)&lt;br&gt;now: UDP over IP&lt;br&gt;target: LoRa (SX1262) via Reticulum&lt;br&gt;(can pass relay Nodes)" style="ellipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="315" width="280" height="160" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b&gt;C4 Transport Adapter&lt;/b&gt; (hub instance)&lt;br&gt;moves signed packets on one carrier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e89;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1040" y="360" width="250" height="70" as="geometry"/></mxCell><mxCell id="v11" value="&lt;b&gt;C3 Node&lt;/b&gt; (hub instance)&lt;br&gt;queues, signs, verifies messages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e89;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1040" y="530" width="250" height="70" as="geometry"/></mxCell><mxCell id="v12" value="&lt;b&gt;C5 Hub&lt;/b&gt;&lt;br&gt;stores validated readings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e89;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1380" y="530" width="220" height="70" as="geometry"/></mxCell><mxCell id="v13" value="&lt;b&gt;SQLite database&lt;/b&gt;&lt;br&gt;(external library)&lt;br&gt;table &lt;i&gt;readings&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#eeeeee;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1400" y="340" width="180" height="110" as="geometry"/></mxCell><mxCell id="v14" value="&lt;b&gt;Build machine&lt;/b&gt; (external platform)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="240" y="700" width="480" height="170" as="geometry"/></mxCell><mxCell id="v15" value="Deployment&lt;br&gt;engineer" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="760" width="40" height="70" as="geometry"/></mxCell><mxCell id="v16" value="&lt;b&gt;C6 Builder&lt;/b&gt;&lt;br&gt;validates one device configuration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e89;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="390" y="760" width="250" height="70" as="geometry"/></mxCell><mxCell id="e17" value="I1" style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v4" target="v5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="I2" style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v5" target="v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="I3" style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;" edge="1" parent="1" source="v6" target="v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e20" value="I4" style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;" edge="1" parent="1" source="v7" target="v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e21" value="I5" style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;" edge="1" parent="1" source="v8" target="v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="I5" style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;" edge="1" parent="1" source="v9" target="v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23" value="I4" style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;" edge="1" parent="1" source="v10" target="v11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" value="I6" style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;" edge="1" parent="1" source="v11" target="v12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e25" value="I7" style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;" edge="1" parent="1" source="v12" target="v13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e26" value="I8" style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v15" target="v16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e27" value="I9: node.toml, edge.toml&lt;br&gt;to the field device" style="endArrow=open;html=1;strokeWidth=2;dashed=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#6c3483;fontColor=#6c3483;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.766;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v16" target="v2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e28" value="I9: node.toml, hub.flags&lt;br&gt;to the hub host" style="endArrow=open;html=1;strokeWidth=2;dashed=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#6c3483;fontColor=#6c3483;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v16" target="v3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860" y="795"/><mxPoint x="860" y="675"/><mxPoint x="1320" y="675"/></Array></mxGeometry></mxCell><mxCell id="v29" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;verticalAlign=top;align=left;spacingLeft=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="700" width="640" height="290" as="geometry"/></mxCell><mxCell id="v30" value="C#" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e89;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1015" y="730" width="60" height="30" as="geometry"/></mxCell><mxCell id="v31" value="Component that the team builds. Two boxes with the same C# are one component deployed twice." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1085" y="725" width="540" height="40" as="geometry"/></mxCell><mxCell id="v32" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;dashed=1;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1015" y="775" width="60" height="30" as="geometry"/></mxCell><mxCell id="v33" value="External system (grey dashed box, cylinder, or oval): hardware, a library, or a network that the team does not build." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1085" y="777" width="540" height="30" as="geometry"/></mxCell><mxCell id="v34" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1015" y="815" width="60" height="30" as="geometry"/></mxCell><mxCell id="v35" value="External host platform that runs the components inside it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1085" y="817" width="540" height="30" as="geometry"/></mxCell><mxCell id="v36" value="&lt;b&gt;&amp;#8212;&amp;#9654;&lt;/b&gt; Runtime data interface. A double arrow carries a request and a reply. &lt;b&gt;I#&lt;/b&gt; matches the interface table." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1015" y="852" width="620" height="36" as="geometry"/></mxCell><mxCell id="v37" value="&lt;font color='#6c3483'&gt;&lt;b&gt;- - &amp;gt;&lt;/b&gt; Build-time interface: configuration files that the engineer copies to a host. The arrow ends at the host frame.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1015" y="890" width="620" height="36" as="geometry"/></mxCell><mxCell id="v38" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1035" y="932" width="18" height="40" as="geometry"/></mxCell><mxCell id="v39" value="Person who uses the system." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1085" y="940" width="540" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>